# Copy this file to .env; never commit .env or paste its values in screenshots.
# Local mode: omit DATABASE_URL to use server/data/store.json.
# Render + Supabase: use the exact Session pooler PostgreSQL connection string
# from Supabase > Connect (port 5432), with the database password substituted.
# Percent-encode special characters in the password (e.g. @ -> %40).
# Append ?sslmode=require if not already present.
DATABASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PORT=3000
HOST=127.0.0.1

# Required to unlock private records and live actions in Integrations.
ADMIN_USERNAME=demo
ADMIN_PASSWORD=

# Optional random secret (32+ characters); otherwise sessions use a random process-local secret.
SESSION_SECRET=
