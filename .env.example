# ScopePay AI 2.2 — public visitor workspaces with Bring Your Own Keys (BYOK)
# Local mode: omit DATABASE_URL to use visitor-isolated JSON files.
# Render: use the Supabase Session Pooler connection string (IPv4-compatible),
# not the direct db.<project>.supabase.co host on IPv4-only hosts.
# Percent-encode special characters in the database password.
DATABASE_URL=

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# Required before visitors can save integration credentials. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this value stable; changing it makes previously stored encrypted keys unreadable.
CREDENTIALS_ENCRYPTION_KEY=

# Optional AI model selection; each visitor supplies their own Gemini API key in Integrations.
GEMINI_MODEL=gemini-2.5-flash

# Optional legacy-owner-only credentials. Not required for public visitor access.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Server settings
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
PAYPAL_ENV=sandbox
